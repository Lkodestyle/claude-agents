{
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "supabase": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest"]
    },
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "obsidian-vault": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@bitbonsai/mcpvault@latest", "${OBSIDIAN_VAULT_PATH:-~/obsidian-vault}"],
      "disabled": true
    },
    "jarvis-memory": {
      "type": "stdio",
      "command": "${JARVIS_MEMORY_BIN:-./bin/jarvis-memory}",
      "env": {
        "JARVIS_DATA_DIR": "${JARVIS_DATA_DIR:-~/.jarvis/memory}",
        "VOYAGE_API_KEY": "${VOYAGE_API_KEY:-}",
        "JARVIS_VOYAGE_MODEL": "${JARVIS_VOYAGE_MODEL:-voyage-3.5-lite}",
        "JARVIS_EMBED_MODEL": "${JARVIS_EMBED_MODEL:-nomic-embed-text}",
        "JARVIS_OLLAMA_URL": "${JARVIS_OLLAMA_URL:-}",
        "JARVIS_USE_OPENAI": "${JARVIS_USE_OPENAI:-false}"
      },
      "disabled": true,
      "_comment": "Jarvis mode core. Build with ./scripts/build-jarvis-memory.sh. Provider priority: Voyage (VOYAGE_API_KEY) > OpenAI (JARVIS_USE_OPENAI=true + OPENAI_API_KEY) > Ollama (default). Flip disabled:false to activate."
    }
  },

  "_mcp_proxy_config": {
    "description": "Alternative: Use mcp-proxy to aggregate all servers into one endpoint",
    "setup_instructions": [
      "1. Install mcp-proxy: go install github.com/tbxark/mcp-proxy@latest",
      "2. Copy mcp-proxy-config.json to your preferred location",
      "3. Run: mcp-proxy -config mcp-proxy-config.json",
      "4. Replace mcpServers above with the mcp-proxy-unified section below"
    ],
    "mcp_proxy_unified": {
      "mcp-proxy": {
        "type": "sse",
        "url": "http://localhost:9090/fetch/sse",
        "headers": {
          "Authorization": "Bearer ${MCP_PROXY_TOKEN}"
        }
      }
    }
  }
}
