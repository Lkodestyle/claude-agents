# Normalize every text file to LF in the repo and on checkout.
# This repo is edited from both WSL and Windows; forcing LF everywhere
# keeps `git status` free of CRLF noise (bash, python and go all handle LF).
* text=auto eol=lf

# Explicit rules for the file types we care most about
*.sh text eol=lf
*.py text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Windows-only scripts need CRLF to run under cmd
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never touch line endings
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.mp3 binary
*.wav binary
